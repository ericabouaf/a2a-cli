{
  "name": "a2a-cli",
  "version": "1.0.1",
  "description": "A simple CLI client for A2A agents",
  "main": "dist/cli.js",
  "bin": {
    "a2a-cli": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": ["a2a", "cli", "agent"],
  "author": "Eric Abouaf <eric.abouaf@gmail.com>",
  "license": "ISC",
  "dependencies": {
    "@a2a-js/sdk": "^0.3.4",
    "commander": "^14.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
